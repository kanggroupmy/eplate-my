{
  "name": "eplate-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"console.error('Retired deployment path. Deploy website/ to Vercel; read RETIREMENT.md.'); process.exit(1)\"",

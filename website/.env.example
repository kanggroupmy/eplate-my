# Public Supabase project URL and publishable/anon key; never put a service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical HTTPS origin, without trailing slash. Both values must match.
NEXT_PUBLIC_SITE_URL=
APP_URL=
# Optional public business WhatsApp contact.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Server-only Supabase service credential; configure in deployment secret manager.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only random value (at least 32 characters) for private rate-limit fingerprints.
RATE_LIMIT_SECRET=
# live in production; sandbox or fake only in nonproduction runtime.
PAYMENT_PROVIDER_MODE=
# Explicit opt-in for local fake adapters; never set on hosted production.
ALLOW_LOCAL_FAKE_PROVIDERS=
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
# Meta credentials and approved version/language/template mapping, JSON event:name.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TEMPLATE_MAP=
# Scheduler bearer credential; random, at least 32 characters.
CRON_SECRET=
# live by default; fake requires explicit local opt-in and nonproduction runtime.
WHATSAPP_PROVIDER_MODE=
# Meta application secret for X-Hub-Signature-256 delivery webhook validation.
WHATSAPP_APP_SECRET=
# Random webhook verification value (at least 32 characters).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
